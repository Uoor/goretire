<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.aliren</groupId>
        <artifactId>aliren-backend</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>aliren-app</artifactId>
    <name>aliren-app</name>
    <description>校友安居 - 应用入口模块（启动类与配置，依赖全部业务模块，唯一可执行）</description>

    <dependencies>
        <!-- 依赖全部业务模块；新增模块（demand/subscribe/match/robot...）在此追加 -->
        <dependency>
            <groupId>com.aliren</groupId>
            <artifactId>aliren-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.aliren</groupId>
            <artifactId>aliren-houserent</artifactId>
        </dependency>

        <!-- H2：本地无 MySQL 时联调用（schema-h2.sql），生产走 MySQL，此依赖冗余无害 -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- 可执行包加 classifier（继承自父 pom 的 repackage execution 也会应用此配置）：
                         生成 aliren-app-exec.jar 为可执行 fat jar，同时保留普通 aliren-app.jar
                         供 test 等依赖方作为编译/运行 classpath（fat jar 的 BOOT-INF 结构无法直接使用） -->
                    <classifier>exec</classifier>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
