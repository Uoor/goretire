# ============================================================
# 校友安居后端 · 环境变量模板
# 用法：复制为 backend/.env（或注入到进程环境），填写真实值后启动。
# 注意：.env 已被 gitignore，绝不提交真实凭证到代码库。
#
# 本地注入示例：
#   cd backend
#   set -a && source .env && set +a
#   java -jar app/target/aliren-app-0.1.0-SNAPSHOT-exec.jar --server.port=8081
#
# Docker 注入：docker run --env-file backend/.env ...
# systemd 注入：EnvironmentFile=/path/to/backend/.env
# ============================================================

# ---- 数据库（本机 MySQL）----
DB_PASSWORD=Test!123

# ---- JWT 密钥（生产务必更换为强随机值）----
JWT_SECRET=aliren-dev-secret-key-please-change-in-prod-0123456789

# ---- 钉钉免登（钉钉开放平台 → 企业内部应用）----
# AppKey / AppSecret：应用凭证（免登换 userid、机器人 access_token 都需要）
DING_APP_KEY=
DING_APP_SECRET=
# CorpId：组织 ID（钉钉管理后台/开放平台首页可见）
DING_CORP_ID=

# ---- 机器人推送（群卡片/工作通知；不配则走日志桩）----
# ROBOT_ENABLED=true 时启用 DingTalkPushClient（需先配上面 DING_APP_KEY/SECRET）
ROBOT_ENABLED=false
# 群自定义机器人 Webhook（可选；Stream 模式机器人则用 key/secret 另行配置）
ROBOT_WEBHOOK=

# ---- LLM 匹配引擎（可选；不配则本地过滤降级）----
LLM_API_KEY=
LLM_MODEL=qwen-max

# ---- 图片上传目录 ----
UPLOAD_DIR=./uploads
