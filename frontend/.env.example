# ============================================================
# 校友安居前端 · 环境变量模板
# 复制为 frontend/.env 填写（Vite 原生加载，VITE_ 前缀暴露给客户端）
# 注意：.env 已被 gitignore，绝不提交真实值
# ============================================================

# 钉钉 CorpId：H5 免登 requestAuthCode 需要（钉钉容器内使用）
# 浏览器联调可留空（自动走 dev-code 桩）
VITE_DING_CORP_ID=

# 钉钉 AppKey：OAuth2 网页扫码登录需要（浏览器环境）
# 与后端 aliren.dingtalk.app-key 相同（clientId 是公开值，不是密钥）
VITE_DING_APP_KEY=

# 租房群入群：优先配置邀请链接（VITE_GROUP_INVITE_URL，钉钉群二维码链接，
# 形如 https://qr.dingtalk.com/action/joingroup?code=...，钉钉容器内点击直接唤起加群页）；
# 未配置链接时可用群号（VITE_GROUP_INVITE_NUMBER）兜底：弹窗展示群号 + 复制 + 钉钉搜索指引
VITE_GROUP_INVITE_URL=
VITE_GROUP_INVITE_NUMBER=

# PC 浏览器引导页开关（测试期默认开启：PC 浏览器统一引导手机扫码，
# 因为 PC 端钉钉会拦截非白名单域名，仅移动端钉钉可正常访问）。
# 正式域名上线、PC 端可用后设 false 关闭。
VITE_PC_GUIDE_ENABLED=true

